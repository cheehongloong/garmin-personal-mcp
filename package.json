{
  "name": "garmin-personal-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted remote MCP server for Garmin Connect Personal API on Cloudflare Workers",
  "type": "module",
  "packageManager": "yarn@4.19.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.3.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "agents": "^0.34.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.0",
    "@cloudflare/workers-types": "^5.20261123.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wrangler": "^4.168.0"
  }
}
