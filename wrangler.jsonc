{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "garmin-personal-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "vars": {
    // REQUIRED: Set to your exact GitHub username. The Worker fails closed if unset.
    "ALLOWED_GITHUB_LOGIN": "",
    // RECOMMENDED: Your immutable numeric GitHub user ID (`gh api user --jq .id`).
    // When set, both login AND ID must match, so a renamed/recycled username can't get in.
    "ALLOWED_GITHUB_ID": "",
    // Comma-separated OAuth redirect hostnames allowed to receive access (blocks consent phishing).
    // Defaults to Claude + Gemini. Add e.g. "localhost,127.0.0.1" for local MCP clients, or "*" for any.
    "ALLOWED_REDIRECT_HOSTS": "claude.ai,oauth-redirect.googleusercontent.com",
    // IANA timezone used for "today" and default date ranges (e.g. "America/New_York").
    "TIMEZONE": "UTC",
    // Official Garmin Connect Personal API base URL.
    "GARMIN_BASE_URL": "https://personal.connectapi.garmin.com"
  },
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "REPLACE_WITH_YOUR_KV_NAMESPACE_ID"
    }
  ],
  // Free per-IP throttle on /authorize, /callback, /oauth/register, /oauth/token
  // (protects the Workers KV Free daily write quota). namespace_id is any account-unique integer.
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 }
    }
  ]
}
